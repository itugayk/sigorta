---
import Icon from './Icon.astro';
import { site } from '../data/site';
interface Props {
  title?: string;
  subtitle?: string;
}
const {
  title = 'Dakikalar içinde teklifinizi alın',
  subtitle = '20+ sigorta şirketini karşılaştırıp size en uygun teklifi sunalım. Tamamen ücretsiz, hiçbir yükümlülük yok.',
} = Astro.props;
---
<section class="container-x">
  <div data-reveal-group class="reveal relative overflow-hidden rounded-3xl bg-navy-800 px-6 py-14 sm:px-12 sm:py-16">
    <div class="bg-grid absolute inset-0 opacity-40"></div>
    <span class="absolute -right-16 -top-16 h-64 w-64 rounded-full bg-trust-500/20 blur-3xl"></span>
    <span class="absolute -bottom-20 -left-10 h-56 w-56 rounded-full bg-navy-400/20 blur-3xl"></span>

    <div class="relative mx-auto max-w-2xl text-center">
      <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider text-trust-300">
        <Icon name="bolt" class="h-3.5 w-3.5" /> Ücretsiz teklif
      </span>
      <h2 class="mt-4 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">{title}</h2>
      <p class="mt-4 text-base leading-relaxed text-navy-200 sm:text-lg">{subtitle}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/teklif-al" class="inline-flex items-center gap-2 rounded-xl bg-trust-500 px-6 py-3.5 text-base font-semibold text-white shadow-lg shadow-trust-500/25 transition-all hover:bg-trust-400 hover:shadow-trust-500/40">
          Hemen Teklif Al <Icon name="arrow-right" class="h-5 w-5" />
        </a>
        <a href={site.phoneHref} class="inline-flex items-center gap-2 rounded-xl border border-white/20 bg-white/5 px-6 py-3.5 text-base font-semibold text-white transition-colors hover:bg-white/10">
          <Icon name="phone" class="h-5 w-5 text-trust-300" /> {site.phone}
        </a>
      </div>
    </div>
  </div>
</section>
