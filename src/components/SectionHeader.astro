---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'center' | 'left';
  light?: boolean;
}
const { eyebrow, title, subtitle, align = 'center', light = false } = Astro.props;
---
<div
  data-reveal-group
  class:list={[
    'max-w-2xl',
    align === 'center' ? 'mx-auto text-center' : 'text-left',
  ]}
>
  {eyebrow && (
    <span class:list={['reveal inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider', light ? 'bg-white/10 text-trust-300' : 'bg-trust-50 text-trust-600']}>
      <span class="h-1.5 w-1.5 rounded-full bg-trust-500"></span>
      {eyebrow}
    </span>
  )}
  <h2 class:list={['reveal mt-4 font-display text-3xl font-bold tracking-tight sm:text-4xl', light ? 'text-white' : 'text-navy-900']}>
    {title}
  </h2>
  {subtitle && (
    <p class:list={['reveal mt-4 text-base leading-relaxed sm:text-lg', light ? 'text-navy-200' : 'text-navy-900/60']}>
      {subtitle}
    </p>
  )}
</div>
