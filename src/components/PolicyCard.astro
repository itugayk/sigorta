---
import Icon from './Icon.astro';
import type { Policy } from '../data/site';
interface Props { policy: Policy; }
const { policy } = Astro.props;
const isTrust = policy.accent === 'trust';
---
<a
  href={`/sigorta-turleri/${policy.slug}`}
  class="reveal group relative flex flex-col overflow-hidden rounded-2xl border border-navy-100 bg-white p-6 shadow-card transition-all duration-300 hover:-translate-y-1.5 hover:border-trust-200 hover:shadow-card-hover"
>
  <span class:list={['absolute -right-8 -top-8 h-28 w-28 rounded-full opacity-60 blur-2xl transition-opacity group-hover:opacity-100', isTrust ? 'bg-trust-100' : 'bg-navy-100']}></span>

  <span class:list={['relative grid h-14 w-14 place-items-center rounded-xl transition-transform duration-300 group-hover:scale-105', isTrust ? 'bg-trust-500 text-white' : 'bg-navy-700 text-white']}>
    <Icon name={policy.icon} class="h-7 w-7" />
  </span>

  <h3 class="relative mt-5 font-display text-lg font-bold text-navy-900">{policy.title}</h3>
  <p class="relative mt-1.5 text-sm leading-relaxed text-navy-900/60">{policy.short}</p>

  <span class="relative mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-trust-600">
    Detayları gör
    <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
  </span>
</a>
