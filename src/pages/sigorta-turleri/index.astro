---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import PolicyCard from '../../components/PolicyCard.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { policies } from '../../data/site';
---
<Layout title="Sigorta Türleri" description="Trafik, kasko, sağlık, konut, DASK, hayat ve işyeri sigortası — Güven Sigorta Acentesi ile tüm poliçe türlerini karşılaştırın.">
  <!-- Page hero -->
  <section class="relative overflow-hidden bg-navy-900">
    <div class="bg-grid absolute inset-0 opacity-25"></div>
    <span class="absolute -right-20 -top-16 h-80 w-80 rounded-full bg-trust-500/15 blur-3xl"></span>
    <div class="container-x relative py-16 sm:py-20">
      <nav class="flex items-center gap-2 text-sm text-navy-300" aria-label="breadcrumb">
        <a href="/" class="hover:text-white">Ana Sayfa</a>
        <span>/</span>
        <span class="text-white">Sigorta Türleri</span>
      </nav>
      <h1 class="mt-4 max-w-2xl font-display text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
        Tüm sigorta türleri tek noktada
      </h1>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-navy-200">
        Bireysel ve kurumsal ihtiyaçlarınıza uygun poliçeyi seçin. Her tür için detaylı teminat bilgisi ve hızlı teklif imkânı.
      </p>
    </div>
  </section>

  <section class="container-x py-16 sm:py-20">
    <div data-reveal-group class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {policies.map((p) => <PolicyCard policy={p} />)}
    </div>
  </section>

  <!-- Coverage comparison teaser -->
  <section class="container-x pb-16">
    <div data-reveal-group class="reveal grid gap-8 rounded-3xl border border-navy-100 bg-navy-50/50 p-8 sm:p-12 lg:grid-cols-2 lg:items-center">
      <div>
        <h2 class="font-display text-2xl font-bold text-navy-900 sm:text-3xl">Hangi poliçe size uygun, emin değil misiniz?</h2>
        <p class="mt-3 text-navy-900/65">Uzman danışmanlarımız ihtiyacınızı analiz edip 20+ şirket arasından size en uygun teminatı tarafsızca önerir.</p>
        <a href="/teklif-al" class="mt-6 inline-flex items-center gap-2 rounded-xl bg-trust-500 px-6 py-3.5 font-semibold text-white transition-colors hover:bg-trust-600">
          Ücretsiz danışmanlık <Icon name="arrow-right" class="h-5 w-5" />
        </a>
      </div>
      <ul class="grid gap-3 sm:grid-cols-2">
        {['Tarafsız karşılaştırma', 'Size özel danışman', 'Hızlı poliçe', 'Yenileme hatırlatma', 'Hasar takibi', 'Ücretsiz teklif'].map((f) => (
          <li class="flex items-center gap-3 rounded-xl bg-white px-4 py-3 text-sm font-medium text-navy-900 shadow-card">
            <span class="grid h-6 w-6 place-items-center rounded-full bg-trust-50 text-trust-600"><Icon name="check" class="h-4 w-4" /></span>
            {f}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="pb-8"><CtaBanner /></div>
</Layout>
