---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PolicyCard from '../components/PolicyCard.astro';
import Accordion from '../components/Accordion.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { policies, insurers, stats, steps, reasons, testimonials, faqs, site } from '../data/site';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.slice(0, 6).map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Layout jsonLd={faqLd}>
  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden bg-navy-950">
    <div class="bg-grid absolute inset-0 opacity-30"></div>
    <span data-parallax="0.3" class="absolute -right-24 top-0 h-[34rem] w-[34rem] rounded-full bg-navy-700/40 blur-3xl"></span>
    <span data-parallax="0.15" class="absolute -left-20 bottom-0 h-96 w-96 rounded-full bg-trust-500/15 blur-3xl"></span>

    <div class="container-x relative grid items-center gap-12 py-16 lg:grid-cols-2 lg:py-24">
      <!-- Copy -->
      <div data-reveal-group>
        <span class="reveal inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider text-trust-300">
          <span class="h-1.5 w-1.5 rounded-full bg-trust-500"></span>
          {site.foundedYear}'dan beri bağımsız acente
        </span>
        <h1 class="reveal mt-5 font-display text-4xl font-extrabold leading-[1.08] tracking-tight text-white sm:text-5xl lg:text-[3.4rem]">
          Sizi ve sevdiklerinizi <span class="text-trust-400">güvenle</span> koruyoruz
        </h1>
        <p class="reveal mt-5 max-w-xl text-lg leading-relaxed text-navy-200">
          Trafik, kasko, sağlık, konut, DASK, hayat ve işyeri sigortalarında 20+ şirketi karşılaştırıp size en uygun teklifi sunuyoruz. Tek noktadan, tarafsız ve hızlı.
        </p>
        <div class="reveal mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/teklif-al" class="inline-flex items-center justify-center gap-2 rounded-xl bg-trust-500 px-6 py-3.5 text-base font-semibold text-white shadow-lg shadow-trust-500/25 transition-all hover:bg-trust-400">
            Hemen Teklif Al <Icon name="arrow-right" class="h-5 w-5" />
          </a>
          <a href="/sigorta-turleri" class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/20 bg-white/5 px-6 py-3.5 text-base font-semibold text-white transition-colors hover:bg-white/10">
            Sigorta Türleri
          </a>
        </div>
        <ul class="reveal mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm text-navy-200">
          {['Ücretsiz teklif', 'Hızlı hasar desteği', '7/24 danışman'].map((t) => (
            <li class="flex items-center gap-2">
              <span class="grid h-5 w-5 place-items-center rounded-full bg-trust-500/20 text-trust-400"><Icon name="check" class="h-3.5 w-3.5" /></span>
              {t}
            </li>
          ))}
        </ul>
      </div>

      <!-- Visual card -->
      <div data-reveal-group class="relative">
        <div class="reveal relative rounded-3xl border border-white/10 bg-gradient-to-br from-white/10 to-white/[0.02] p-6 backdrop-blur-sm sm:p-8">
          <div class="flex items-center gap-3">
            <span class="grid h-12 w-12 place-items-center rounded-2xl bg-trust-500 text-white"><Icon name="shield-check" class="h-7 w-7" /></span>
            <div>
              <p class="font-display text-lg font-bold text-white">Koruma Paketiniz</p>
              <p class="text-sm text-navy-300">Size özel teminat planı</p>
            </div>
          </div>
          <div class="mt-6 space-y-3">
            {policies.slice(0, 4).map((p) => (
              <div class="flex items-center justify-between rounded-xl bg-white/5 px-4 py-3">
                <span class="flex items-center gap-3 text-sm font-medium text-white">
                  <Icon name={p.icon} class="h-5 w-5 text-trust-400" /> {p.title}
                </span>
                <span class="flex items-center gap-1.5 text-xs font-semibold text-trust-400">
                  <Icon name="check" class="h-4 w-4" /> Aktif
                </span>
              </div>
            ))}
          </div>
          <div class="mt-6 flex items-center justify-between rounded-xl bg-trust-500/15 px-4 py-3.5">
            <span class="text-sm text-navy-100">Tahmini aylık prim</span>
            <span class="font-display text-xl font-bold text-white">₺ 1.250<span class="text-sm font-normal text-navy-300">/ay</span></span>
          </div>
        </div>
        <span class="absolute -bottom-4 -left-4 hidden rounded-2xl border border-white/10 bg-navy-900 px-4 py-3 shadow-xl sm:block">
          <span class="flex items-center gap-2 text-sm font-semibold text-white"><Icon name="users" class="h-5 w-5 text-trust-400" /> 18.000+ mutlu müşteri</span>
        </span>
      </div>
    </div>

    <!-- Insurer logos strip -->
    <div class="relative border-t border-white/10 bg-navy-950/60">
      <div class="container-x py-6">
        <p class="text-center text-xs font-medium uppercase tracking-wider text-navy-400">Anlaşmalı sigorta şirketleri</p>
        <div class="mt-4 flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
          {insurers.map((name) => (
            <span class="font-display text-base font-semibold text-navy-300/80 transition-colors hover:text-white sm:text-lg">{name}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ POLICY GRID ============ -->
  <section class="container-x py-20 sm:py-24">
    <SectionHeader
      eyebrow="Sigorta Türleri"
      title="İhtiyacınıza uygun koruma"
      subtitle="Bireysel ve kurumsal tüm sigorta ihtiyaçlarınız için tek adres. Detaylar için kartlara göz atın."
    />
    <div data-reveal-group class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {policies.map((p) => <PolicyCard policy={p} />)}
      <a href="/teklif-al" class="reveal group flex flex-col items-center justify-center gap-3 rounded-2xl border-2 border-dashed border-navy-200 bg-navy-50/50 p-6 text-center transition-colors hover:border-trust-300 hover:bg-trust-50/50">
        <span class="grid h-14 w-14 place-items-center rounded-xl bg-white text-trust-600 shadow-card"><Icon name="plus" class="h-7 w-7" /></span>
        <span class="font-display text-base font-bold text-navy-900">Hepsini karşılaştır</span>
        <span class="text-sm text-navy-900/55">Size özel teklif alın</span>
      </a>
    </div>
  </section>

  <!-- ============ WHY US + STATS ============ -->
  <section class="bg-navy-50/60 py-20 sm:py-24">
    <div class="container-x">
      <SectionHeader
        eyebrow="Neden Biz?"
        title="Güven Sigorta farkı"
        subtitle="Tek bir şirkete bağlı kalmadan, çıkarınızı önceleyerek en doğru teminatı sunuyoruz."
      />

      <div data-reveal-group class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {reasons.map((r) => (
          <div class="reveal rounded-2xl border border-navy-100 bg-white p-6 shadow-card">
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-trust-50 text-trust-600"><Icon name={r.icon} class="h-6 w-6" /></span>
            <h3 class="mt-4 font-display text-lg font-bold text-navy-900">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-navy-900/60">{r.desc}</p>
          </div>
        ))}
      </div>

      <!-- Stat counters -->
      <div data-reveal-group class="mt-12 grid grid-cols-2 gap-5 rounded-3xl border border-navy-100 bg-white p-8 shadow-card lg:grid-cols-4">
        {stats.map((s) => (
          <div class="reveal text-center">
            <p class="font-display text-4xl font-extrabold text-navy-700 sm:text-5xl">
              <span data-counter={s.value} data-suffix={s.suffix}>0{s.suffix}</span>
            </p>
            <p class="mt-2 text-sm font-medium text-navy-900/60">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ PROCESS ============ -->
  <section class="container-x py-20 sm:py-24">
    <SectionHeader
      eyebrow="Nasıl Çalışır?"
      title="3 adımda poliçeniz hazır"
      subtitle="Karmaşık süreçlerle uğraşmayın. Bilgi verin, teklifleri karşılaştırın, poliçenizi alın."
    />
    <div data-reveal-group class="relative mt-14 grid gap-8 md:grid-cols-3">
      <span class="absolute left-0 right-0 top-7 hidden h-px bg-gradient-to-r from-transparent via-navy-200 to-transparent md:block"></span>
      {steps.map((step) => (
        <div class="reveal relative text-center">
          <div class="relative z-10 mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-navy-700 font-display text-lg font-bold text-white shadow-lg shadow-navy-700/20">
            {step.n}
          </div>
          <div class="mx-auto mt-4 grid h-12 w-12 place-items-center rounded-xl bg-trust-50 text-trust-600">
            <Icon name={step.icon} class="h-6 w-6" />
          </div>
          <h3 class="mt-4 font-display text-lg font-bold text-navy-900">{step.title}</h3>
          <p class="mx-auto mt-2 max-w-xs text-sm leading-relaxed text-navy-900/60">{step.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ TESTIMONIALS ============ -->
  <section class="bg-navy-950 py-20 sm:py-24">
    <div class="container-x">
      <SectionHeader
        eyebrow="Müşteri Yorumları"
        title="Binlerce kişi bize güveniyor"
        subtitle="Müşterilerimizin deneyimleri, doğru işi nasıl yaptığımızın en iyi kanıtı."
        light
      />
      <div data-reveal-group class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {testimonials.map((t) => (
          <figure class="reveal flex h-full flex-col rounded-2xl border border-white/10 bg-white/[0.04] p-6">
            <Icon name="quote" class="h-7 w-7 text-trust-400" />
            <blockquote class="mt-4 flex-1 text-sm leading-relaxed text-navy-100">{t.text}</blockquote>
            <div class="mt-5 flex items-center gap-1 text-trust-400">
              {Array.from({ length: t.rating }).map(() => <Icon name="star" class="h-4 w-4 fill-current" />)}
            </div>
            <figcaption class="mt-4 border-t border-white/10 pt-4">
              <p class="font-display text-sm font-bold text-white">{t.name}</p>
              <p class="text-xs text-navy-400">{t.role}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="container-x py-20 sm:py-24">
    <SectionHeader
      eyebrow="SSS"
      title="Sık sorulan sorular"
      subtitle="Aklınıza takılanları yanıtladık. Daha fazlası için iletişime geçebilirsiniz."
    />
    <div class="mt-12">
      <Accordion items={faqs.slice(0, 6)} />
    </div>
    <p class="mt-6 text-center text-sm text-navy-900/60">
      Başka sorunuz mu var? <a href="/sss" class="font-semibold text-trust-600 hover:underline">Tüm SSS</a> ya da <a href="/iletisim" class="font-semibold text-trust-600 hover:underline">iletişim</a>.
    </p>
  </section>

  <!-- ============ CTA ============ -->
  <div class="pb-8">
    <CtaBanner />
  </div>
</Layout>
