---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { posts } from '../../data/site';

const sorted = [...posts].sort((a, b) => (a.date < b.date ? 1 : -1));
const [featured, ...rest] = sorted;
const fmt = (d: string) => new Date(d).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Layout title="Blog" description="Sigorta dünyasından güncel bilgiler, ipuçları ve rehberler — Güven Sigorta Acentesi blog.">
  <section class="relative overflow-hidden bg-navy-900">
    <div class="bg-grid absolute inset-0 opacity-25"></div>
    <span class="absolute -right-20 -top-16 h-80 w-80 rounded-full bg-trust-500/15 blur-3xl"></span>
    <div class="container-x relative py-16 sm:py-20">
      <nav class="flex items-center gap-2 text-sm text-navy-300" aria-label="breadcrumb">
        <a href="/" class="hover:text-white">Ana Sayfa</a><span>/</span><span class="text-white">Blog</span>
      </nav>
      <h1 class="mt-4 font-display text-4xl font-extrabold tracking-tight text-white sm:text-5xl">Sigorta rehberi & blog</h1>
      <p class="mt-4 max-w-xl text-lg text-navy-200">Doğru poliçeyi seçmenize yardımcı olacak güncel bilgiler ve pratik ipuçları.</p>
    </div>
  </section>

  <section class="container-x py-16 sm:py-20">
    <!-- Featured -->
    <a href={`/blog/${featured.slug}`} data-reveal-group class="reveal group grid overflow-hidden rounded-3xl border border-navy-100 bg-white shadow-card transition-all hover:shadow-card-hover lg:grid-cols-2">
      <div class="relative min-h-[220px] bg-navy-800">
        <div class="bg-grid absolute inset-0 opacity-30"></div>
        <span class="absolute -right-10 -top-10 h-48 w-48 rounded-full bg-trust-500/20 blur-3xl"></span>
        <div class="relative grid h-full place-items-center p-10">
          <Icon name="doc" class="h-20 w-20 text-trust-400/80" />
        </div>
      </div>
      <div class="p-8 sm:p-10">
        <span class="inline-flex items-center gap-2 rounded-full bg-trust-50 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-trust-600">{featured.category}</span>
        <h2 class="mt-4 font-display text-2xl font-bold leading-tight text-navy-900 group-hover:text-navy-700 sm:text-3xl">{featured.title}</h2>
        <p class="mt-3 leading-relaxed text-navy-900/60">{featured.excerpt}</p>
        <div class="mt-5 flex items-center gap-4 text-sm text-navy-900/50">
          <span>{fmt(featured.date)}</span><span>·</span><span>{featured.readMins} dk okuma</span>
        </div>
        <span class="mt-6 inline-flex items-center gap-1.5 font-semibold text-trust-600">Yazıyı oku <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" /></span>
      </div>
    </a>

    <!-- Rest -->
    <div data-reveal-group class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {rest.map((post) => (
        <a href={`/blog/${post.slug}`} class="reveal group flex flex-col overflow-hidden rounded-2xl border border-navy-100 bg-white shadow-card transition-all hover:-translate-y-1 hover:shadow-card-hover">
          <div class="relative h-40 bg-navy-700">
            <div class="bg-grid absolute inset-0 opacity-30"></div>
            <div class="relative grid h-full place-items-center"><Icon name="doc" class="h-12 w-12 text-trust-400/70" /></div>
            <span class="absolute left-4 top-4 rounded-full bg-white/90 px-2.5 py-1 text-xs font-semibold text-navy-700">{post.category}</span>
          </div>
          <div class="flex flex-1 flex-col p-6">
            <h3 class="font-display text-lg font-bold leading-snug text-navy-900 group-hover:text-navy-700">{post.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-navy-900/60">{post.excerpt}</p>
            <div class="mt-4 flex items-center gap-3 text-xs text-navy-900/50">
              <span>{fmt(post.date)}</span><span>·</span><span>{post.readMins} dk</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <div class="pb-8"><CtaBanner /></div>
</Layout>
